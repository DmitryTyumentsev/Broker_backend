# dev: секреты приезжают из окружения, в git их нет.
#
#   FIXATIONSERVICE_DATABASE_POSTGRES_DSN   полный DSN с ролью go_user
#   FIXATIONSERVICE_BUSINESS_HASH_SECRET    соль для хэша телефона
#
# Соль телефона — не декоративная: по phone_hash строится уникальный
# индекс, и смена соли обесценивает все существующие фиксации.

ENVIRONMENT=dev
