# Только то, что отличается от local.yaml или является секретом.
#
# Правило: всё, что можно держать в yaml — держим в yaml. Здесь оседает
# ровно то, что либо меняется от машины к машине, либо не должно попадать
# в git на проде. Дублировать сюда весь конфиг нельзя: env перекрывает
# yaml молча, и потом полдня ищешь, почему сервис ходит не туда.
#
# Имя переменной = префикс сервиса + путь в yaml, точки на подчёркивания:
#   database.postgres.dsn → FIXATIONSERVICE_DATABASE_POSTGRES_DSN

ENVIRONMENT=local
