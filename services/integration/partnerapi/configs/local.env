# Только то, что отличается от local.yaml или является секретом.
# См. комментарий в fixationservice/configs/local.env.
#
# Раньше здесь лежали PARTNERAPI_SERVER_PORT=8081 и
# PARTNERAPI_AUTH_GRPC_ADDRESS=localhost:50052 — оба перекрывали yaml
# неверными значениями: сервис слушал не тот порт и ходил за авторизацией
# в fixationservice.

ENVIRONMENT=local
