              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{brokerId}}\",\n  \"phone\": \"+7 (999) 000-00-08\",\n  \"project_id\": \"{{projectId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
