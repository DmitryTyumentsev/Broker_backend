              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh}}\",\n  \"device_id\": \"{{deviceId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/auth/logout",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "Регистрация",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new-{{$randomInt}}@perviy-metr.test\",\n  \"password\": \"Passw0rd!2024\",\n  \"last_name\": \"Новиков\",\n  \"first_name\": \"Новый\",\n  \"device_id\": \"{{deviceId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/auth/register",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Самостоятельная регистрация сейчас упирается в открытый вопрос: агентства у нового пользователя нет, а выпуск токена его требует. См. журнал решений в README."
          }
        },
        {
          "name": "Ручка только для админа",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{partnerapi}}/api/v1/admin/ping",
              "host": [
