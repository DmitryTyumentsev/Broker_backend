    {
      "name": "01 · Авторизация",
      "description": "Токены выпускает authservice, проверяет их partnerapi. Один выпускающий на весь стенд.",
      "item": [
        {
          "name": "Логин (сохраняет токен)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Токен сразу уезжает в переменную коллекции — руками его",
                  "// копировать не надо, все защищённые запросы подтянут сами.",
                  "if (pm.response.code !== 200) {",
                  "    console.log('логин не прошёл:', pm.response.text());",
                  "    return;",
                  "}",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "if (body.access) {",
                  "    pm.collectionVariables.set('token', body.access);",
                  "}",
                  "if (body.refresh) {",
                  "    pm.collectionVariables.set('refresh', body.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{brokerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"device_id\": \"{{deviceId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/auth/login",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Кто я (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{partnerapi}}/api/v1/me",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Показывает, что именно лежит в принципале: agency_id, user_id, device_id, роль. Отсюда видно, от чьего имени пойдут остальные запросы."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// agencyId и brokerId берём из принципала, а не из вывода make seed:",
                  "// так они гарантированно совпадают с тем токеном, под которым",
                  "// сейчас работаешь. Остальные идентификаторы — из окружения,",
                  "// его собирает `make postman-env`.",
                  "if (pm.response.code !== 200) { return; }",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "if (body.agency_id) { pm.collectionVariables.set(\"agencyId\", body.agency_id); }",
                  "if (body.user_id)   { pm.collectionVariables.set(\"brokerId\", body.user_id); }",
                  "",
                  "console.log(\"agencyId =\", body.agency_id, \"| brokerId =\", body.user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Обновить токен",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code !== 200) { return; }",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "if (body.access) { pm.collectionVariables.set('token', body.access); }",
                  "if (body.refresh) { pm.collectionVariables.set('refresh', body.refresh); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh}}\",\n  \"device_id\": \"{{deviceId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/auth/refresh",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Выход",
          "request": {
