    {
      "name": "02 · Фиксации",
      "description": "Горячий путь. Все запросы идут под токеном из «Логина»: agency_id partnerapi берёт из принципала, в теле его нет.\n\nВ каждом ответе есть заголовок X-Request-ID — по нему запрос ищется в логах partnerapi и fixationservice.",
      "item": [
        {
          "name": "Создать фиксацию",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.fixation_id) {",
                  "        pm.collectionVariables.set('fixationId', body.fixation_id);",
                  "    }",
                  "}",
                  "",
                  "console.log('X-Request-ID:', pm.response.headers.get('X-Request-ID'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}",
                "description": "новый на каждый запуск; чтобы проверить повтор — зафиксируй значение руками"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{brokerId}}\",\n  \"phone\": \"{{phone}}\",\n  \"project_id\": \"{{projectId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "fixations"
              ]
            }
          }
        },
        {
          "name": "Проект, которого нет в app.projects",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{brokerId}}\",\n  \"phone\": \"+7 (999) 000-00-01\",\n  \"project_id\": \"{{$randomUUID}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "fixations"
              ]
            },
            "description": "Синтаксически корректный UUID, которого нет в справочнике. Генерируется на месте через {{$randomUUID}} — сеять такое в базу нечего.\n\nЭто шаг 2 из «шагов воспроизведения» тикета B-1."
          }
        },
        {
          "name": "Архивный проект",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{brokerId}}\",\n  \"phone\": \"+7 (999) 000-00-02\",\n  \"project_id\": \"{{archivedProjectId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "fixations"
              ]
            },
            "description": "Проект в базе есть, статус archived. archivedProjectId берётся из вывода make seed."
          }
        },
        {
          "name": "Брокер из чужого агентства",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{foreignBrokerId}}\",\n  \"phone\": \"+7 (999) 000-00-03\",\n  \"project_id\": \"{{projectId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "fixations"
              ]
            },
            "description": "Токен от агентства A, fix_for — сотрудник агентства B."
          }
        },
        {
          "name": "Проект + чужой брокер одновременно",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{foreignBrokerId}}\",\n  \"phone\": \"+7 (999) 000-00-04\",\n  \"project_id\": \"{{archivedProjectId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "fixations"
              ]
            },
            "description": "Два нарушения сразу. Какая ошибка побеждает — это порядок проверок, и он должен быть осознанным, а не случайным."
          }
        },
        {
          "name": "project_id — не UUID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{brokerId}}\",\n  \"phone\": \"+7 (999) 000-00-05\",\n  \"project_id\": \"не-уuid-вовсе\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "fixations"
              ]
            },
            "description": "Граничный случай из тикета: мусор в поле должен отсекаться раньше, чем запрос дойдёт до базы. Где именно он отсекается — проверь по логам."
          }
        },
        {
          "name": "Без Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fix_for\": \"{{brokerId}}\",\n  \"phone\": \"+7 (999) 000-00-06\",\n  \"project_id\": \"{{projectId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
                "{{partnerapi}}"
              ],
              "path": [
                "api",
                "v1",
                "fixations"
              ]
            }
          }
        },
        {
          "name": "Повтор с тем же ключом",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "fixed-key-repeat-me",
                "description": "значение НЕ случайное: смысл в том, чтобы отправить дважды"
              }
