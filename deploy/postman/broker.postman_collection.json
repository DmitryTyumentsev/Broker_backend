              "raw": "{\n  \"fix_for\": \"{{brokerId}}\",\n  \"phone\": \"+7 (999) 000-00-07\",\n  \"project_id\": \"{{projectId}}\"\n}"
            },
            "url": {
              "raw": "{{partnerapi}}/api/v1/fixations",
              "host": [
